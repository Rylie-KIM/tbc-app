# TBC environment template. Same keys, same order as .env, but NO real values.
# Copy to .env and fill it in. .env is ignored by git; this file is committed.
# Never paste real values into this file, into chat, or into an issue.
# On Vercel, enter the same keys under Project Settings > Environment Variables
# (the local .env is not read there).

# --- Supabase: Project Settings > API ---
# Project URL (not a secret). Browser-readable copy: Next.js only exposes names starting with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Browser-side copy of the publishable key, under the older "anon" name that some libraries still look for.
# Safe to be public, but only if Row Level Security is ON for every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Older name of the SECRET key. SERVER ONLY. Never expose it, never prefix it with NEXT_PUBLIC_.
# Keep it only if a library still expects this name; otherwise use SUPABASE_SECRET_KEY below.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase: Project Settings > Database ---
# Database password. If it has special characters (@ : / # ? % !), URL-encode them
# inside DATABASE_URL and DIRECT_URL below (for example ! becomes %21).
SUPABASE_DB_PASSWORD=
# Pooled connection ("Transaction pooler", port 6543). Use it from Vercel and other serverless code.
# Easiest: Connect button > Transaction pooler > copy the string, then replace [YOUR-PASSWORD]. Ours: aws-1-eu-west-1.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres
# Direct connection (port 5432). Use it for migrations and backups, not from serverless code.
DIRECT_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# --- Supabase: current key names (Project Settings > API Keys) ---
# Project URL for server-side code (not a secret).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key. Designed to be public; protection comes from Row Level Security.
SUPABASE_PUBLISHABLE_KEY=
# SECRET key. SERVER ONLY. Can read and write everything. Never expose it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Address of the project's signing keys (not a secret).
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json

# --- OpenRouter: the AI behind "Tell us what you are looking for" (task F25.10) ---
# Key from openrouter.ai/keys. SERVER ONLY. Without it the search falls back to a plain keyword match.
OPENROUTER_API_KEY=
# Optional: the model (default openai/gpt-oss-20b:free), the daily call cap (default 40) and a test address.
# OPENROUTER_MODEL=
# AI_DAILY_CAP=40
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Later (not needed yet) ---
